# Never expose provider keys through NEXT_PUBLIC_ variables.

# Existing RapidAPI marketplace provider
RAPIDAPI_HOST=sportapi7.p.rapidapi.com
RAPIDAPI_KEY=

# Optional direct/custom provider endpoint
LIVE_SCORES_API_URL=
LIVE_SCORES_API_KEY=

# Optional Highlightly feed. Confirm the live endpoint for your plan.
HIGHLIGHTLY_API_KEY=
HIGHLIGHTLY_LIVE_URL=https://api.highlightly.net/football/events/live

# Optional API-Football feed (football only)
API_FOOTBALL_KEY=
APIFOOTBALL_LIVE_URL=https://v3.football.api-sports.io/fixtures?live=all

# Optional SportsDataIO feed. SPORTSDATAIO_LIVE_URL overrides the default.
SPORTSDATAIO_KEY=
SPORTSDATAIO_LIVE_URL=